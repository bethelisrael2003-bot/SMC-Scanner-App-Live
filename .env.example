# Exness Direct Trading API Credentials (Demo Account)
# Security Rule: Never commit real credentials to Git.
# Local environment: Save these in /home/user/smc-app-live/.env (automatically gitignored)
# Render production: Configure in Render Dashboard -> Environment -> Environment Variables
EXN_API_KEY=exnsk-your_api_key_here
EXN_PRIVATE_KEY=your_128_hex_character_private_key_or_pem_here
EXN_ACCOUNT_ID=your_exness_account_id_here
EXN_DISCOVERY_BASE_URL=https://gateway.exness.com
EXN_IS_DEMO=true

# Capital.com Credentials (Legacy Defense Mode - Read Only)
CAPITAL_API_KEY=your_capital_api_key
CAPITAL_EMAIL=your_email
CAPITAL_PASSWORD=your_password

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Environment
NODE_ENV=development
PORT=3000

# Backend URL for Frontend (use your Render URL when deployed)
VITE_API_URL=http://localhost:3000

# MongoDB URI (Atlas Connection String)
MONGODB_URI=your_mongodb_atlas_uri

# Secret for cron trigger
CRON_SECRET=my_secret_token
